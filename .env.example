# ---------- Frontend (Vite) ----------
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
VITE_SUPABASE_URL=https://your-project.supabase.co

# Local / AWS: SPA calls same-origin /functions/v1/* (Vite proxy or nginx → Deno).
# Do not send Playwright/orchestrate to hosted Edge (150s idle timeout).
VITE_USE_LOCAL_BACKEND=true
# Escape hatch only — hosted Edge for every function, including 150s Playwright kill:
# VITE_USE_CLOUD_FUNCTIONS=true

# Optional allowlist leftover (ignored unless you restore cloud routing in src/lib/functions.ts)
VITE_LOCAL_FUNCTIONS=run-warehouse-sql,test-warehouse-connectivity,agent-orchestrate,agent-scripts,agent-heal,playwright-runtime

# Generate/Regenerate: run live Browserless validation + repair after assemble.
SCRIPT_VALIDATE_ON_GENERATE=true
SCRIPT_VALIDATE_MAX_ATTEMPTS=5

# Script gen + validation progress logs (terminal + JSON under logs/script-agents/).
# SCRIPT_AGENT_LOG=false to disable JSON files (terminal still uses console from callers).
# SCRIPT_AGENT_LOG_DIR=C:\path\to\logs\script-agents
SCRIPT_AGENT_LOG=true

# Required for validation repair / LLM script agents (never commit the real key).
# Bayer Magentic gateway (same as other internal Claude projects):
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://chat.int.bayer.com/anthropic
CLAUDE_MODEL=claude-sonnet-4.5
# Repair POSTs a full script (~60k) through the corp proxy. Default 240s; 90s is too short on VDI.
# ANTHROPIC_FETCH_TIMEOUT_MS=240000

# Docker Desktop on Bayer VDI: containers need the corp proxy to reach Supabase Auth.
# Leave unset on AWS ECS. docker-compose defaults to http://10.185.190.10:8080 when unset.
# HTTP_PROXY=http://10.185.190.10:8080
# HTTPS_PROXY=http://10.185.190.10:8080
# NO_PROXY=127.0.0.1,localhost,browserless,snowflake-sso,backend
# Snowflake SSO sidecar — same proxy; MITM requires insecure SSL on VDI only.
# SNOWFLAKE_INSECURE_SSL=true

# Snowflake SSO / key-pair Python service URL
# Local dev (Python on VDI):  http://127.0.0.1:8002  (not localhost — corp proxy blocks it)
# Docker backend + native SSO: http://host.docker.internal:8002
# Full Docker stack:          http://snowflake-sso:8002
# Key-pair private key files must be readable on this host.
SNOWFLAKE_SSO_URL=http://127.0.0.1:8002
NO_PROXY=127.0.0.1,localhost,chat.int.bayer.com

# Local Deno backend for orchestrator internal calls (warehouse SSO + workstream children)
LOCAL_FUNCTIONS_URL=http://127.0.0.1:8000/functions/v1

# Optional
LOVABLE_API_KEY=

# Browserless OSS (self-hosted) — required for playwright-runtime
# Local Docker:           http://127.0.0.1:3000  (scripts/dev-browserless.ps1)
# Docker Compose stack:   http://browserless:3000
# GitHub Codespaces:      https://<codespace>-3000.app.github.dev
#   1. Open this repo in Codespaces (devcontainer starts Browserless)
#   2. Ports tab → 3000 → visibility Public
#   3. Set BROWSERLESS_HOST to that HTTPS URL and BROWSERLESS_OSS=true
# Browserless Cloud:      production-sfo.browserless.io  (omit scheme; HTTPS is inferred)
BROWSERLESS_HOST=http://127.0.0.1:3000
BROWSERLESS_TOKEN=local-dev-token
# Do not send the VDI corp proxy to Browserless Chromium (ERR_PROXY_CONNECTION_FAILED).
# BROWSERLESS_LAUNCH_ARGS=["--ignore-certificate-errors","--window-size=1920,1080","--force-device-scale-factor=1"]
# BROWSERLESS_OSS=true
# BROWSERLESS_USE_HTTPS=false
# BROWSERLESS_CONCURRENT=10
# BROWSERLESS_QUEUED=10
# Session budget for /chromium/function (compose default 7 minutes). Do not set 30 min.
# BROWSERLESS_TIMEOUT_MS=420000
# How many scenarios scrape at once (1–10). Workstream runs cap in-flight reports at 2
# and split this budget across them so Browserless is not overloaded.
# ORCHESTRATE_CONCURRENCY=3
